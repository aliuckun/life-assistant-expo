{
  "expo": {
    "name": "life-assistant",
    "slug": "life-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/indir.png",
    "scheme": "lifeassistant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/indir.png",
        "backgroundImage": "./src/assets/images/indir.png",
        "monochromeImage": "./src/assets/images/indir.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.lifeassistant"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/indir.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/indir.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d550d307-604a-4061-8602-77c2d15d1b20"
      }
    }
  }
}