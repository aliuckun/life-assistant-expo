{
  "expo": {
    "name": "life-assistant",
    "slug": "life-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/bcg.png",
    "splash": {
      "image": "./src/assets/images/bcg.png",
      "resizeMode": "cover",
      "backgroundColor": "#F5F5F0"
    },
    "scheme": "lifeassistant",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/bcg.png",
        "backgroundImage": "./src/assets/images/bcg.png",
        "monochromeImage": "./src/assets/images/bcg.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.lifeassistant"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/bcg.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d550d307-604a-4061-8602-77c2d15d1b20"
      }
    }
  }
}